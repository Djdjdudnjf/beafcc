# ==========================================================
#  ملف الإعدادات السرية لمشروع "مرشد"
#  انسخ هذا الملف وسمّه .env ثم ضع مفتاحك الحقيقي بالأسفل
# ==========================================================

# مفتاح Claude API الخاص بك (يبدأ عادة بـ sk-ant-)
# احصل عليه من: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=ضع_مفتاحك_هنا

# رقم "الباب" الذي يعمل عليه الخادم على جهازك (اتركه كما هو إن لم تكن تعرف)
PORT=3001

# اسم موديل Claude المستخدم (اتركه كما هو)
ANTHROPIC_MODEL=claude-opus-5

# مستوى العمق في التفكير: low | medium | high | xhigh | max
# كلما زاد المستوى صارت الإجابات أعمق لكن أبطأ وأغلى
ANTHROPIC_EFFORT=high

# أقصى عدد كلمات (رموز) في الرد الواحد
MAX_TOKENS=8000

# عدد الرسائل السابقة التي تُرسل مع كل سؤال (لتذكّر سياق المحادثة)
HISTORY_LIMIT=30

# ==========================================================
# رمز دخول اختياري لحماية الموقع
# ==========================================================
# اتركه فارغاً عند التشغيل على جهازك (لا أحد غيرك يستطيع الوصول أصلاً).
#
# 🔴 لكن إذا نشرت الموقع على الإنترنت فاملأه بالتأكيد،
#    وإلا استطاع أي شخص يعرف الرابط استخدام موقعك واستهلاك رصيدك.
# اختر شيئاً يصعب تخمينه، مثال: Murshid2026Kx9zR
ACCESS_CODE=
#
# ⚠️ تنبيه: علامة # تعني "تعليق" في هذا الملف، فلو كتبت  ACCESS_CODE=abc#123
#    سيُقرأ الرمز كـ "abc" فقط! لذلك:
#      - إما استخدم حروفاً وأرقاماً فقط (الأسهل والموصى به)
#      - أو ضع الرمز بين علامتي تنصيص هكذا:  ACCESS_CODE="abc#123"

