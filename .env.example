# انسخ هذا الملف إلى .env واملأ مفتاحك، أو صدّر المتغيرات مباشرة قبل التشغيل.

# ================= Anthropic (Claude) =================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# الموديل: claude-haiku-5-5 (الأرخص) | claude-sonnet-5-5 (توازن، الافتراضي) | claude-opus-5-5 (الأقوى)
ANTHROPIC_MODEL=claude-sonnet-5-5

# ================= أو OpenAI =================
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_MODEL=gpt-4o

# ================= اختياري =================
PORT=8787
MAX_FRAMES=14
# لنقاط متوافقة مع OpenAI (OpenRouter، موديل محلي…)
# OPENAI_BASE=https://openrouter.ai/api
