# انسخ هذا الملف إلى .env واملأ مفتاحك، أو صدّر المتغيرات مباشرة قبل التشغيل.

# ---- اختر مزودًا واحدًا ----
# OpenAI (الأبسط، يدعم الرؤية)
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_MODEL=gpt-4o

# أو Anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---- اختياري ----
PORT=8787
MAX_FRAMES=14
# لنقاط متوافقة مع OpenAI (OpenRouter، نموذج محلي، ...)
# OPENAI_BASE=https://openrouter.ai/api
